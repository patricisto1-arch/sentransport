# ---------------------------------------------------------------------------
# API — toutes les requêtes passent par la passerelle Nginx (/api).
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000

# true  -> MSW intercepte les appels (démo sans backend)
# false -> appels réels vers la passerelle Nginx
VITE_USE_MOCKS=true

# Optionnel : cible du proxy Vite en développement (laisser vide en prod)
VITE_API_PROXY_TARGET=
